[Desktop Entry]
Name=Hyshot
GenericName=Image Editor
GenericName[zh_CN]=图片标注
Comment=Open and annotate images
Comment[zh_CN]=打开图片并标注
Exec=/home/nana/.cargo/bin/hyshot edit %F
TryExec=/home/nana/.cargo/bin/hyshot
Icon=/home/nana/.local/share/icons/hicolor/scalable/apps/hyshot.svg
Terminal=false
Type=Application
Categories=Graphics;
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/gif;
StartupWMClass=site.nullable.annotator
