[Desktop Entry]
Name=Hyshot
GenericName=Screenshot and Image Annotation
GenericName[zh_CN]=截图与图片标注
Comment=Capture screenshots, edit images, and create scrolling screenshots
Comment[zh_CN]=截图、图片标注、长截图与录屏
Exec=hyshot edit %F
TryExec=hyshot
Icon=site.nullable.annotator
Terminal=false
Type=Application
Categories=Graphics;
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/gif;
StartupWMClass=site.nullable.annotator
Actions=Annotate;Longshot;Record;

[Desktop Action Annotate]
Name=Capture and Annotate
Name[zh_CN]=截图并标注
Exec=hyshot annotate

[Desktop Action Longshot]
Name=Scrolling Screenshot
Name[zh_CN]=长截图（开始或结束）
Exec=hyshot longshot --edit

[Desktop Action Record]
Name=Screen Recording
Name[zh_CN]=录屏（开始或结束）
Exec=hyshot record
